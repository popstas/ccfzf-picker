{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccfzf-picker",
  "version": "0.4.4",
  "identifier": "pro.popstas.ccfzf-picker",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-frontend.js",
    "beforeDevCommand": "node scripts/prepare-frontend.js",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "picker",
      "title": "claude sessions",
      "width": 900,
      "height": 640,
      "center": true,
      "resizable": true,
      "decorations": false,
      "alwaysOnTop": true,
      "visible": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
